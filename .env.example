SPRING_MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/Notes
SPRING_APPLICATION_NAME=Notes
TRUE_OR_FALSE=true

REDIS_HOST=localhost
REDIS_PORT=6379
TIMEOUT_MS=300000

JWT_SECRET=<256-bit-hex-secret>
JWT_ACCESS_EXPIRY=900000
JWT_REFRESH_EXPIRY=604800000

SERVER_PORT=8080
BCRYPT_STRENGTH=12